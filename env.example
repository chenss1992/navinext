APP_NAME=Navidrome Manager
APP_SECRET=change-this-to-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
TIMEZONE=Asia/Shanghai

# Navidrome URL reachable from the manager container
NAVIDROME_URL=http://192.168.2.2:4533
# Navidrome administrator credentials
NAVIDROME_USERNAME=admin
NAVIDROME_PASSWORD=your-navidrome-admin-password

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=12345678
TELEGRAM_DAILY_REPORT_ENABLED=true
TELEGRAM_WEEKLY_REPORT_ENABLED=true
TELEGRAM_MONTHLY_REPORT_ENABLED=true
TELEGRAM_EXPIRE_REMINDER_ENABLED=true
REPORT_HOUR=9
EXPIRE_REMINDER_DAYS=7,3,1,0

# Polling interval in minutes
TASK_INTERVAL_MINUTES=10
